# Deploy to /root/hft3/.env on CHI404 (chmod 600). Do not commit filled copy.

HFT3_DEPLOY_HOST=CHI404
HFT3_PUBLIC_IP=64.44.98.219
HFT3_ENV=bare_metal_paper
HFT3_REPO_DIR=/root/hft3

# CPU layout (Ryzen 9900X: 12c/24t) — adjust after 01_kernel_tuning.sh
HOT_CPUS=2-11
HFT3_ISOL_CPUS=2-11
HFT3_RITHMIC_CPU=1
HFT3_OS_CPU=0
HFT3_NIC=
HFT3_GATEWAY_IP=
HFT3_RITHMIC_HOST=

# Rithmic R|API paper (not Trader Pro GUI)
RITHMIC_ENVIRONMENT=Rithmic Paper Trading
RITHMIC_USERNAME=
RITHMIC_PASSWORD=
RITHMIC_APP_NAME=HFT3
RITHMIC_APP_VERSION=1.0
RITHMIC_SYMBOL=MES
RITHMIC_EXCHANGE=CME
