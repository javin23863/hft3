[Unit]
Description=Bitcoin Edge Processing Daemon
After=bitcoind.service network-online.target
Requires=bitcoind.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/btc-edge-daemon-run
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/btc-edge-daemon /tmp

[Install]
WantedBy=multi-user.target
