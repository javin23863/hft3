{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ghost Route Event Log Row",
  "type": "object",
  "required": [
    "signal_id",
    "timestamp_signal",
    "timestamp_order_arrival",
    "macro_contract",
    "micro_contract",
    "direction",
    "macro_bid",
    "macro_ask",
    "macro_bid_size",
    "macro_ask_size",
    "micro_bid",
    "micro_ask",
    "micro_bid_size",
    "micro_ask_size",
    "shadow_decay_side",
    "NSD",
    "CTR",
    "nOFI",
    "spread_zscore",
    "expected_edge_ticks",
    "target_price",
    "target_quantity",
    "available_depth_at_signal",
    "available_depth_at_arrival",
    "fill_status",
    "filled_quantity",
    "fill_price",
    "micro_reprice_time",
    "lead_time_us",
    "markout_10us",
    "markout_25us",
    "markout_50us",
    "markout_100us",
    "markout_250us",
    "markout_1ms",
    "net_pnl",
    "reject_reason"
  ],
  "properties": {
    "signal_id": {"type": "string"},
    "timestamp_signal": {"type": ["integer", "string"]},
    "timestamp_order_arrival": {"type": ["integer", "string"]},
    "macro_contract": {"enum": ["ES", "NQ", "YM"]},
    "micro_contract": {"enum": ["MES", "MNQ", "MYM"]},
    "direction": {"enum": ["BUY", "SELL"]},
    "fill_status": {
      "enum": [
        "FULL_FILL",
        "PARTIAL_FILL",
        "MISS_STALE_QUOTE_GONE",
        "MISS_REPRICED_BEFORE_ARRIVAL",
        "MISS_INSUFFICIENT_DEPTH",
        "REJECT_DATA_QUALITY",
        "REJECT_RISK_BLOCK"
      ]
    },
    "reject_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
