{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hft3.local/schemas/workbench_runtime_contract_v1.json",
  "title": "Workbench Runtime Contract",
  "type": "object",
  "required": [
    "schema_version",
    "contract_scope",
    "run_sources",
    "model_states",
    "artifact_states",
    "data_states",
    "robustness_states",
    "cme_lane_states",
    "backend_endpoints",
    "tabs",
    "blocker_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "workbench_runtime_contract_v1"
    },
    "contract_scope": {
      "type": "string",
      "minLength": 1
    },
    "run_sources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "model_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "artifact_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "data_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "robustness_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "cme_lane_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "backend_endpoints": {
      "type": "array",
      "items": {"$ref": "#/$defs/backend_endpoint"},
      "minItems": 1
    },
    "tabs": {
      "type": "array",
      "items": {"$ref": "#/$defs/tab_contract"},
      "minItems": 1
    },
    "blocker_policy": {
      "type": "object",
      "required": [
        "silent_blockers_allowed",
        "fake_pass_allowed",
        "llm_authority",
        "untested_idea_selection_allowed",
        "cme_live_route_authority"
      ],
      "properties": {
        "silent_blockers_allowed": {"const": false},
        "fake_pass_allowed": {"const": false},
        "llm_authority": {"const": "advisory_only"},
        "untested_idea_selection_allowed": {"const": false},
        "cme_live_route_authority": {"const": "CHI404_only"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "backend_endpoint": {
      "type": "object",
      "required": [
        "id",
        "cli",
        "request_schema",
        "response_schema",
        "error_response"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "cli": {"type": "string", "minLength": 1},
        "request_schema": {"type": "string", "minLength": 1},
        "response_schema": {"type": "string", "minLength": 1},
        "error_response": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "tab_contract": {
      "type": "object",
      "required": [
        "name",
        "purpose",
        "frontend_component",
        "action_components",
        "backend_service",
        "runtime_state",
        "required_config",
        "required_artifacts",
        "required_schema",
        "pipeline_dependency",
        "expected_output",
        "error_behavior",
        "allowed_actions"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "frontend_component": {"type": "string", "minLength": 1},
        "action_components": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "backend_service": {"type": "string", "minLength": 1},
        "runtime_state": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "required_config": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "required_artifacts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "required_schema": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "pipeline_dependency": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "expected_output": {"type": "string", "minLength": 1},
        "error_behavior": {"type": "string", "minLength": 1},
        "allowed_actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
