{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hft3.local/schemas/workbench_runtime_contract_v1.json",
  "title": "Workbench Runtime Contract",
  "type": "object",
  "required": [
    "schema_version",
    "contract_scope",
    "run_sources",
    "model_states",
    "artifact_states",
    "data_states",
    "robustness_states",
    "cme_lane_states",
    "backend_endpoints",
    "tabs",
    "blocker_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "workbench_runtime_contract_v1"
    },
    "contract_scope": {
      "type": "string",
      "minLength": 1
    },
    "run_sources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "model_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "artifact_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "data_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "robustness_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "cme_lane_states": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "backend_endpoints": {
      "type": "array",
      "items": {"$ref": "#/$defs/backend_endpoint"},
      "minItems": 1
    },
    "tabs": {
      "type": "array",
      "items": {"$ref": "#/$defs/tab_contract"},
      "minItems": 1
    },
    "blocker_policy": {
      "type": "object",
      "required": [
        "silent_blockers_allowed",
        "fake_pass_allowed",
        "llm_authority",
        "untested_idea_selection_allowed",
        "cme_live_route_authority"
      ],
      "properties": {
        "silent_blockers_allowed": {"const": false},
        "fake_pass_allowed": {"const": false},
        "llm_authority": {"const": "advisory_only"},
        "untested_idea_selection_allowed": {"const": false},
        "cme_live_route_authority": {"const": "CHI404_only"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "backend_endpoint": {
      "type": "object",
      "required": [
        "id",
        "cli",
        "request_schema",
        "response_schema",
        "error_response"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "cli": {"type": "string", "minLength": 1},
        "request_schema": {"type": "string", "minLength": 1},
        "response_schema": {"type": "string", "minLength": 1},
        "error_response": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "tab_contract": {
      "type": "object",
      "required": [
        "name",
        "purpose",
        "frontend_component",
        "action_components",
        "backend_service",
        "runtime_state",
        "required_config",
        "required_artifacts",
        "required_schema",
        "pipeline_dependency",
        "expected_output",
        "error_behavior",
        "allowed_actions"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "frontend_component": {"type": "string", "minLength": 1},
        "action_components": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "backend_service": {"type": "string", "minLength": 1},
        "runtime_state": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$",
            "enum": [
              "RunEvidenceSnapshot.after_action",
              "RunEvidenceSnapshot.artifacts",
              "RunEvidenceSnapshot.backtest",
              "RunEvidenceSnapshot.current_stage",
              "RunEvidenceSnapshot.data",
              "RunEvidenceSnapshot.decision",
              "RunEvidenceSnapshot.diagnostics",
              "RunEvidenceSnapshot.finished_at",
              "RunEvidenceSnapshot.latency",
              "RunEvidenceSnapshot.registry",
              "RunEvidenceSnapshot.relationships",
              "RunEvidenceSnapshot.reports",
              "RunEvidenceSnapshot.robustness",
              "RunEvidenceSnapshot.root",
              "RunEvidenceSnapshot.run_id",
              "RunEvidenceSnapshot.self_learning_loop",
              "RunEvidenceSnapshot.source",
              "RunEvidenceSnapshot.stages",
              "RunEvidenceSnapshot.started_at",
              "RunEvidenceSnapshot.state",
              "RunEvidenceSnapshot.system",
              "RunEvidenceSnapshot.trade_manager",
              "data.event_universe",
              "data.rithmic_trial",
              "diagnostics.feature_fabric",
              "latency.ibkr_endpoint",
              "latency.rithmic_endpoint",
              "latency.rithmic_order_ack",
              "personal.sandbox_lock",
              "personal.selected_model",
              "personal.selected_symbol",
              "registry.event_universe",
              "registry.lane_registry",
              "system.feature_fabric",
              "system.ibkr_endpoint",
              "system.lane_registry",
              "system.llm_providers",
              "system.rithmic_endpoint",
              "ui.session_state.wb_audit_grade",
              "ui.session_state.wb_defensive_stubs",
              "ui.session_state.wb_wallet_activity",
              "ui.session_state.wb_wallet_last_receive",
              "ui.session_state.wb_wallet_last_send",
              "ui.session_state.wb_wallet_passphrase_nonce",
              "ui.session_state.wb_wallet_refreshed_at",
              "ui.session_state.wb_wallet_refresh_seconds",
              "ui.session_state.wb_wallet_send_message",
              "ui.session_state.wb_wallet_send_preview",
              "ui.session_state.wb_wallet_snapshot"
            ]
          }
        },
        "required_config": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "required_artifacts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "required_schema": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "pipeline_dependency": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "expected_output": {"type": "string", "minLength": 1},
        "error_behavior": {"type": "string", "minLength": 1},
        "allowed_actions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
