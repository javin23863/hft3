# Copy to .env locally (never commit .env)

# Databento (research / replay)
DATABENTO_API_KEY=

# CHI404 bare-metal server (SSH alias: chi404)
CHI404_HOST=64.44.98.219
CHI404_SSH_USER=root
CHI404_SSH_ALIAS=chi404

# Rithmic paper — credentials and tuning live on CHI404 (/root/hft3/.env), not the workstation
RITHMIC_ENVIRONMENT=Rithmic Paper Trading
RITHMIC_USERNAME=
RITHMIC_PASSWORD=
RITHMIC_APP_NAME=HFT3
RITHMIC_APP_VERSION=1.0
RITHMIC_GATEWAY=Chicago
HFT3_RITHMIC_HOST=
HFT3_REPO_DIR=/root/hft3/repo
HFT3_COLO_NTP=
RTRADER_INSTALLER_PATH=
RTRADER_WINE_PREFIX=/root/.wine-rtrader
# CHI404 Windows VM sidecar (see docs/rithmic_trial/CHI404_VM_BUGS.md)
VM_ADMIN_PASSWORD=
# NAT DHCP lease; run `virsh domifaddr hft3-rtrader-win` on CHI404 for current IP
VM_WINRM_HOST=192.168.122.136
RTRADER_VM_MEMORY=16384
RTRADER_VM_VCPUS=4
RTRADER_VM_DISK_SIZE=120
RTRADER_VM_DISK_BUS=virtio
RTRADER_VM_NIC_MODEL=virtio
RTRADER_VM_BRIDGE_NAME=br0
# RTRADER_VM_RECREATE=1
RTRADER_WATCH_DIRS="/root/hft3/rtrader_watch"
RTRADER_START_WINE=0
RTRADER_SMB_USER=rtrader
RTRADER_SMB_HOST=192.168.122.1
RITHMIC_TRIAL_ENABLED=0
RITHMIC_TRIAL_CONNECTOR=rtrader
RITHMIC_TRIAL_CONFIG=data_system/config/rithmic_trial.yaml
