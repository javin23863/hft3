# Copy to .env locally (never commit .env)

# Databento (research / replay)
DATABENTO_API_KEY=

# CHI404 bare-metal server (SSH alias: chi404)
CHI404_HOST=64.44.98.219
CHI404_SSH_USER=root
CHI404_SSH_ALIAS=chi404

# Rithmic — credentials are supplied locally at runtime; never commit them
RITHMIC_ENVIRONMENT=Rithmic Paper Trading
RITHMIC_USERNAME=
RITHMIC_PASSWORD=
RITHMIC_APP_NAME=HFT3
RITHMIC_APP_VERSION=1.0
RITHMIC_GATEWAY=Chicago
HFT3_RITHMIC_HOST=
HFT3_REPO_DIR=/root/hft3/repo
HFT3_COLO_NTP=
RTRADER_INSTALLER_PATH=
RTRADER_WINE_PREFIX=/root/.wine-rtrader
# CHI404 Windows VM sidecar (see docs/rithmic_trial/CHI404_VM_BUGS.md)
VM_ADMIN_PASSWORD=
# NAT DHCP lease; run `virsh domifaddr hft3-rtrader-win` on CHI404 for current IP
VM_WINRM_HOST=192.168.122.136
RTRADER_VM_MEMORY=16384
RTRADER_VM_VCPUS=4
RTRADER_VM_DISK_SIZE=120
RTRADER_VM_DISK_BUS=virtio
RTRADER_VM_NIC_MODEL=virtio
RTRADER_VM_BRIDGE_NAME=br0
# RTRADER_VM_RECREATE=1
RTRADER_WATCH_DIRS="/root/hft3/rtrader_watch"
RTRADER_START_WINE=0
RTRADER_SMB_USER=rtrader
RTRADER_SMB_HOST=192.168.122.1
RITHMIC_TRIAL_ENABLED=1
RITHMIC_TRIAL_CONNECTOR=rithmic_api
RITHMIC_TRIAL_CONFIG=packages/data_system/config/rithmic_trial.yaml

# Rithmic R|API Plus. Paper/Chicago stays blocked until Rithmic supplies
# the Paper/Chicago host/domain/connect-point parameters.
RITHMIC_ENDPOINT_PROFILE=paper_chicago
RITHMIC_API_SYSTEM=Rithmic Paper Trading
RITHMIC_API_GATEWAY=Chicago
RITHMIC_API_CONFIG=packages/data_system/config/rithmic_api_paper.yaml
# R|Protocol websocket market-data endpoint for headless Paper/Chicago smoke.
# This is not the R|API+ MML host list and must not point to Test/Orangeburg.
RITHMIC_PROTOCOL_URL=

# Workstation LLM — OpenAI-compatible GPT-5.5 runtime, not vendored repos.
HFT3_LLM_BASE_URL=https://api.openai.com/v1
HFT3_LLM_API_KEY=
HFT3_LLM_MODEL=gpt-5.5
HFT3_AAR_LLM_MODEL=gpt-5.5
HFT3_RESEARCH_LLM_MODEL=gpt-5.5
HFT3_MODEL_DEVELOPMENT_LLM_MODEL=gpt-5.5
HFT3_LLM_REASONING_EFFORT=xhigh
HFT3_LLM_TIMEOUT_S=600

# Crypto lane — B2 + APIs (copy from local keys.env; never commit)
HFT3_CRYPTO_B2_KEY_ID=
HFT3_CRYPTO_B2_APP_KEY=
HFT3_CRYPTO_B2_BUCKET=crypto-alpha-datasets
HFT3_CRYPTO_B2_SOURCE_BUCKET=quant-x-datasets
HFT3_CRYPTO_B2_ENDPOINT=
CRYPTOCOMPARE_API_KEY=
ETHERSCAN_API_KEY=
FRED_API_KEY=
# Kraken REST API (spot + futures)
HFT3_CRYPTO_KRAKEN_API_KEY=
HFT3_CRYPTO_KRAKEN_PRIVATE_KEY=
# Optional path to desk keys.env (gitignored)
CRYPTO_KEYS_ENV=
