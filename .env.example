# Copy to .env locally (never commit .env)

# Databento (research / replay)
DATABENTO_API_KEY=

# CHI404 bare-metal server (SSH alias: chi404)
CHI404_HOST=64.44.98.219
CHI404_SSH_USER=root
CHI404_SSH_ALIAS=chi404

# Rithmic paper — credentials and tuning live on CHI404 (/root/hft3/.env), not the workstation
RITHMIC_ENVIRONMENT=Rithmic Paper Trading
RITHMIC_USERNAME=
RITHMIC_PASSWORD=
RITHMIC_APP_NAME=HFT3
RITHMIC_APP_VERSION=1.0
RITHMIC_GATEWAY=Chicago
HFT3_RITHMIC_HOST=
HFT3_REPO_DIR=/root/hft3/repo
HFT3_COLO_NTP=
RTRADER_INSTALLER_PATH=
RTRADER_WINE_PREFIX=/root/.wine-rtrader
# CHI404 Windows VM sidecar (see docs/rithmic_trial/CHI404_VM_BUGS.md)
VM_ADMIN_PASSWORD=
# NAT DHCP lease; run `virsh domifaddr hft3-rtrader-win` on CHI404 for current IP
VM_WINRM_HOST=192.168.122.136
RTRADER_VM_MEMORY=16384
RTRADER_VM_VCPUS=4
RTRADER_VM_DISK_SIZE=120
RTRADER_VM_DISK_BUS=virtio
RTRADER_VM_NIC_MODEL=virtio
RTRADER_VM_BRIDGE_NAME=br0
# RTRADER_VM_RECREATE=1
RTRADER_WATCH_DIRS="/root/hft3/rtrader_watch"
RTRADER_START_WINE=0
RTRADER_SMB_USER=rtrader
RTRADER_SMB_HOST=192.168.122.1
RITHMIC_TRIAL_ENABLED=0
RITHMIC_TRIAL_CONNECTOR=rtrader
RITHMIC_TRIAL_CONFIG=data_system/config/rithmic_trial.yaml

# Workstation LLM (Ollama) — not vendored repos; see docs/research/VENDOR_BOUNDARIES.md
HFT3_OLLAMA_MODEL=gemma4:31b-cloud
HFT3_OLLAMA_TIMEOUT_S=600
HFT3_PIPELINE_LLM_MODEL=glm-5.1:cloud

# Crypto lane — B2 + APIs
# Auto-loaded from sibling quant-x/.env (QXL_KEYS_ENV) and C:/QuantX/keys.env or ~/Desktop/keys.env.
# Override only when not using the QuantX desk keyring:
HFT3_CRYPTO_B2_KEY_ID=
HFT3_CRYPTO_B2_APP_KEY=
# Optional — defaults from packages/crypto_lane/config/lake_sources.yaml when unset
HFT3_CRYPTO_B2_BUCKET=crypto-alpha-datasets
HFT3_CRYPTO_B2_SOURCE_BUCKET=quant-x-datasets
# Optional — native b2sdk auth works without S3-style endpoint
HFT3_CRYPTO_B2_ENDPOINT=
COINSTATS_API_KEY=
CRYPTOCOMPARE_API_KEY=
ETHERSCAN_API_KEY=
FRED_API_KEY=
# Optional desk keyring overrides (default: QXL_KEYS_ENV from quant-x, else C:/QuantX/keys.env)
MACRO_KEYS_ENV=
CRYPTO_KEYS_ENV=
# QuantX master vault pointer (set in ../quant-x/.env on MSI workstations)
# QXL_KEYS_ENV=C:/QuantX/keys.env
