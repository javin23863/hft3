{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FEATURE_CARD",
  "type": "object",
  "required": ["feature_card"],
  "properties": {
    "feature_card": {
      "type": "object",
      "required": [
        "feature_id",
        "feature_family",
        "formula",
        "plain_english_definition",
        "required_inputs",
        "window_type",
        "lookback_window",
        "timestamp_policy",
        "dataset_id",
        "source_tier_required",
        "leakage_risk",
        "expected_range",
        "normalization",
        "missing_value_policy",
        "validation_tests",
        "failure_modes"
      ],
      "properties": {
        "feature_id": { "$ref": "#/definitions/non_empty_string" },
        "feature_family": {
          "enum": [
            "depth",
            "flow",
            "microprice",
            "queue",
            "liquidity_quality",
            "event_intensity",
            "cross_asset",
            "execution",
            "regime",
            "options",
            "equities",
            "equities_l3",
            "crypto"
          ]
        },
        "formula": { "$ref": "#/definitions/non_empty_string" },
        "plain_english_definition": { "$ref": "#/definitions/non_empty_string" },
        "required_inputs": { "$ref": "#/definitions/string_array" },
        "window_type": { "enum": ["event_time", "clock_time", "hybrid"] },
        "lookback_window": { "$ref": "#/definitions/non_empty_string" },
        "timestamp_policy": { "$ref": "#/definitions/non_empty_string" },
        "dataset_id": { "$ref": "#/definitions/non_empty_string" },
        "source_tier_required": { "$ref": "#/definitions/source_tier" },
        "leakage_risk": { "enum": ["low", "medium", "high"] },
        "expected_range": { "$ref": "#/definitions/non_empty_string" },
        "normalization": { "$ref": "#/definitions/non_empty_string" },
        "missing_value_policy": { "$ref": "#/definitions/non_empty_string" },
        "validation_tests": { "$ref": "#/definitions/string_array" },
        "failure_modes": { "$ref": "#/definitions/string_array" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/definitions/non_empty_string" },
      "minItems": 1
    },
    "source_tier": {
      "enum": [
        "tier_0_reality",
        "tier_1_primary",
        "tier_2_vendor_normalized",
        "tier_3_interpretive",
        "tier_4_untrusted_context"
      ]
    }
  }
}
