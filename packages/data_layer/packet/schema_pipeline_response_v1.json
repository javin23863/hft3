{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipelineResponsePacket",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "event_id",
    "llm_model",
    "llm_status",
    "parsed",
    "candidates_tested",
    "results",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "request_id": { "type": "string" },
    "run_id": { "type": "string" },
    "event_id": { "type": "string" },
    "llm_model": { "type": ["string", "null"] },
    "llm_status": {
      "type": "string",
      "enum": ["ok", "skipped_connector", "skipped_uncited_ontology", "skipped_broken_pdf_cite", "skipped_no_llm", "unavailable", "schema_reject"]
    },
    "openfoundry_meta": {
      "type": "object",
      "required": ["connector_id", "asset_class", "vendor_shas", "schema_version"]
    },
    "parsed": {
      "type": "object",
      "required": ["primary_model_id", "instrument_universe", "indicators", "source"],
      "properties": {
        "primary_model_id": { "type": "string" },
        "instrument_universe": { "type": "array", "items": { "type": "string" } },
        "indicators": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" }
      }
    },
    "candidates_tested": { "type": "integer" },
    "selected_model_id": { "type": ["string", "null"] },
    "artifact_dir": { "type": ["string", "null"] },
    "document_summary": { "type": ["string", "null"] },
    "generated_at": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "model_id", "net_pnl", "num_trades", "passes"],
        "properties": {
          "candidate_id": { "type": "string" },
          "model_id": { "type": "string" },
          "net_pnl": { "type": "number" },
          "num_trades": { "type": "integer" },
          "sharpe": { "type": ["number", "null"] },
          "drawdown_bps": { "type": ["number", "null"] },
          "avg_latency_us": { "type": ["number", "null"] },
          "passes": { "type": "boolean" },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "idea_summary": {
      "type": "object",
      "required": [
        "ideas_generated",
        "ideas_static_rejected",
        "ideas_queued_for_test",
        "ideas_tested_fail",
        "ideas_tested_pass",
        "candidates_from_ideas"
      ],
      "properties": {
        "ideas_generated": { "type": "integer", "minimum": 0 },
        "ideas_static_rejected": { "type": "integer", "minimum": 0 },
        "ideas_queued_for_test": { "type": "integer", "minimum": 0 },
        "ideas_tested_fail": { "type": "integer", "minimum": 0 },
        "ideas_tested_pass": { "type": "integer", "minimum": 0 },
        "candidates_from_ideas": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "llm_error": { "type": "string" }
  },
  "additionalProperties": false
}
