{
  "folders": [
    {
      "name": "hft3",
      "path": "."
    }
  ],
  "settings": {
    "python.analysis.extraPaths": [
      "packages",
      "apps",
      "packages/economic_event_universe",
      "packages/data_system",
      "packages/features_engine/src",
      "packages/backtest_pipeline/src",
      "packages/decision_engine/python/src",
      "packages/replay",
      "packages/execution",
      "packages/data_layer",
      "apps/workbench",
      "telemetry/src"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "graphify-out/cache": true
    },
    "search.exclude": {
      "**/graphify-out/cache": true,
      "**/graphify-out/graph.json": true
    }
  }
}
