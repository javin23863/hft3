# Copy to .btc-node.env (repo root or %USERPROFILE%\.btc-node.env) — never commit.
# Requires SSH tunnel: ssh -fN btc-node
# chmod 600 .btc-node.env on Linux/Mac

BTC_RPC_URL=http://USER:PASS@127.0.0.1:18332
BTC_RPC_USER=
BTC_RPC_PASS=
BTC_ZMQ_RAWBLOCK=tcp://127.0.0.1:28332
BTC_ZMQ_RAWTX=tcp://127.0.0.1:28333
