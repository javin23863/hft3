{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MicrostructureAARResponse",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "input_schema_version",
    "llm_model",
    "llm_elapsed_s",
    "llm_status",
    "symbolic_passed",
    "decision",
    "kg_annotations",
    "narrative_md"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "run_id": { "type": "string" },
    "input_schema_version": { "type": "string" },
    "llm_model": { "type": ["string", "null"] },
    "llm_elapsed_s": { "type": ["number", "null"] },
    "llm_status": {
      "type": "string",
      "enum": [
        "ok",
        "skipped_symbolic",
        "skipped_pdf",
        "skipped_connector",
        "skipped_uncited_ontology",
        "skipped_broken_pdf_cite",
        "skipped_history_gate",
        "skipped_audit_incomplete",
        "skipped_flag",
        "skipped_budget",
        "unavailable",
        "schema_reject"
      ]
    },
    "symbolic_passed": { "type": "boolean" },
    "decision": {
      "type": "object",
      "required": ["promote_candidate_recommendation"],
      "properties": {
        "promote_candidate_recommendation": { "type": "boolean" },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "kg_annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_type", "source_id", "field", "value"],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": ["ONTOLOGY_EXTENSION", "PDF_CITATION", "LATENCY_AUTHORITY_FIELD", "SYMBOLIC_RESULT"]
          },
          "source_id": { "type": "string" },
          "field": { "type": "string" },
          "value": {},
          "cite": {
            "type": "object",
            "required": ["pdf", "section", "page"],
            "properties": {
              "pdf": { "type": "string" },
              "section": { "type": "string" },
              "page": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "narrative_md": { "type": "string" },
    "llm_error": { "type": "string" }
  },
  "additionalProperties": false
}
