{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipelineRequestPacket",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "thesis",
    "event_id",
    "openfoundry_meta",
    "max_candidates"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "request_id": { "type": "string" },
    "thesis": { "type": "string" },
    "event_id": { "type": "string" },
    "openfoundry_meta": {
      "type": "object",
      "required": ["connector_id", "asset_class", "vendor_shas", "schema_version"]
    },
    "max_candidates": { "type": "integer", "minimum": 1 },
    "document_ref": { "type": "string" }
  },
  "additionalProperties": false
}
