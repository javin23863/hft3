# Normalize line endings for all text files
* text=auto eol=lf

# Explicitly set line endings for specific file types
*.sh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Binary files should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.npz binary
*.parquet binary
*.dbn binary
*.zst binary
